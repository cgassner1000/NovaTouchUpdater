<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RepositoryRoot)tests/Shared/TestWorkspace.cs" Link="TestWorkspace.cs" />
    <Compile Include="$(RepositoryRoot)src/NovaTouchUpdater/UI/Controls/InformationProgressCell.cs" Link="InformationProgressCell.cs" />
    <Compile Include="$(RepositoryRoot)src/NovaTouchUpdater/UI/Styling/UiTheme.cs" Link="UiTheme.cs" />
    <Compile Include="$(RepositoryRoot)src/NovaTouchUpdater/UI/Styling/UiTheme.Palette.cs" Link="UiTheme.Palette.cs" />
    <Compile Include="$(RepositoryRoot)src/NovaTouchUpdater/UI/Styling/UiTheme.Windows.cs" Link="UiTheme.Windows.cs" />
    <Compile Include="$(RepositoryRoot)src/NovaTouchUpdater/Models/ThemeModes.cs" Link="ThemeModes.cs" />
    <Compile Include="$(RepositoryRoot)src/NovaTouchUpdater/UI/Controls/AdministratorButton.cs" Link="AdministratorButton.cs" />
    <Compile Include="$(RepositoryRoot)src/NovaTouchUpdater/UI/Controls/AppComboBox.cs" Link="AppComboBox.cs" />
    <EmbeddedResource Include="$(RepositoryRoot)src/NovaTouchUpdater/Assets/NovaTouchUpdater.ico" LogicalName="NovaTouchUpdater.AppIcon.ico" />
    <EmbeddedResource Include="$(RepositoryRoot)src/NovaTouchUpdater/Assets/NovaTouchUpdater.png" LogicalName="NovaTouchUpdater.AppIcon.png" />
  </ItemGroup>
</Project>
